# Crea tu app en https://www.strava.com/settings/api
# "Authorization Callback Domain": localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
APP_URL=http://localhost:3000

# IA (OpenRouter) para reajustar rutinas
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Inicio de sesión con Google: https://console.cloud.google.com/apis/credentials
# "ID de cliente de OAuth" → Aplicación web. URIs de redirección autorizados:
#   http://localhost:3000/api/auth/google/callback
#   https://<tu-dominio>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Producción (Vercel)
# Secreto para firmar la sesión (obligatorio si no hay Redis): openssl rand -hex 32
AUTH_SECRET=
# Redis de Upstash: Vercel las crea solas al conectar la base de datos en Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
