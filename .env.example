# Crea tu app en https://www.strava.com/settings/api
# "Authorization Callback Domain": localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
APP_URL=http://localhost:3000

# IA (OpenRouter) para reajustar rutinas y leer capturas
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Producción (Vercel)
# Contraseña de acceso a la app (si se deja vacío, la app queda abierta)
APP_PASSWORD=
# Redis de Upstash: Vercel las crea solas al conectar la base de datos en Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
